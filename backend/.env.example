# ContextLens Backend – Environment Configuration
# NO API KEYS REQUIRED for local models (e.g. Qwen via Ollama, LM Studio, vLLM).
# Copy this file to .env.

# =============================================================================
# Local Model Configuration (Default — NO API KEY REQUIRED!)
# =============================================================================
# Use local model for private, offline, keyless AI inference:
USE_LOCAL_MODEL=true
LLM_PROVIDER=local

# Local model identifier (e.g. qwen2.5:latest, qwen2.5:7b, qwen2.5:1.5b, qwen2.5:14b)
LOCAL_MODEL=qwen2.5:latest

# Local runner host endpoint:
# Default for Ollama: http://localhost:11434
# Default for LM Studio: http://localhost:1234/v1
# Default for vLLM / LocalAI: http://localhost:8000/v1
LOCAL_LLM_URL=http://localhost:11434

# =============================================================================
# Safety & Quality Guardrails (Active by default)
# =============================================================================
# Guardrails automatically enforced on local models:
# 1. Prompt Injection & Adversarial Defense (neutralizes embedded instructions)
# 2. Passage Grounding Verification (filters hallucinated points)
# 3. Canonical Taxonomy Enforcement (SUPPORTED, CONTRADICTED, etc.)
# 4. URL & Citation Integrity (blocks fabricated URLs)
# 5. Confidence Calibration (prevents ungrounded 100% confidence)
# 6. JSON Repair (safely extracts and repairs markdown-wrapped output)

# =============================================================================
# Optional Cloud Providers (Only if not using local models)
# =============================================================================
# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# Source Search Providers (Optional — DuckDuckGo free fallback used if empty)
# =============================================================================
# SerpAPI
SERPAPI_KEY=

# Brave Search
BRAVE_SEARCH_KEY=

# Disable source search entirely (set to "false" to turn off)
# SEARCH_ENABLED=true

# =============================================================================
# Performance Limits
# =============================================================================
# Maximum characters per passage sent to LLM (default: 8000)
# MAX_INPUT_CHARS=8000

# LLM request timeout in seconds (default: 30)
# LLM_TIMEOUT_SECONDS=30

# Maximum search results to retrieve (default: 5)
# MAX_SEARCH_RESULTS=5

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8000
HOST=0.0.0.0

# ContextLens Backend – Environment Configuration
# Copy this file to .env and fill in your API keys.
# Never commit .env to source control.

# =============================================================================
# LLM Provider (at least one is required for AI-powered analysis)
# If none is configured, the backend uses a keyword-based heuristic fallback
# that is clearly labelled as non-AI in every response.
# =============================================================================

# Google Gemini (recommended — free tier available)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model override (optional, defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model override (optional, defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model override (optional, defaults to claude-3-haiku-20240307)
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# Source Search Providers (optional — adds additional source discovery)
# At least one key enables richer search; DuckDuckGo is used as a free fallback.
# =============================================================================

# SerpAPI (recommended — Google search results)
# https://serpapi.com/dashboard
SERPAPI_KEY=

# Brave Search (alternative — privacy-focused)
# https://api.search.brave.com/app/keys
BRAVE_SEARCH_KEY=

# Disable source search entirely (set to "false" to turn off)
# SEARCH_ENABLED=true

# =============================================================================
# Performance & Safety Limits
# =============================================================================

# Maximum characters per passage sent to the LLM (default: 8000)
# MAX_INPUT_CHARS=8000

# LLM request timeout in seconds (default: 30)
# LLM_TIMEOUT_SECONDS=30

# Maximum search results to retrieve (default: 5)
# MAX_SEARCH_RESULTS=5

# Maximum snippet length in characters (default: 400)
# MAX_SNIPPET_CHARS=400

# Search request timeout in seconds (default: 10)
# SEARCH_TIMEOUT_SECONDS=10

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8000
HOST=0.0.0.0

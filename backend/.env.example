# ContextLens Backend Environment Configuration

# Optional: Add any LLM API key. If none is supplied, the backend uses
# its built-in deterministic heuristic context analysis engine (ideal for hackathon demo).

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0

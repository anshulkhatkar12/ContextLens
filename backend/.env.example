# ContextLens Backend Environment Configuration

# ─────────────────────────────────────────────────────────────────────────────
# AI Model Provider Selection
# ─────────────────────────────────────────────────────────────────────────────
# Options:
#   - "gemini"    (Google Gemini via LangChain - Recommended)
#   - "openai"    (OpenAI GPT via LangChain)
#   - "anthropic" (Anthropic Claude via LangChain)
#   - "heuristic" (Built-in offline deterministic engine; no API key needed)
LLM_PROVIDER=gemini

# Specific Model Overrides (Optional; defaults used if left blank)
# Gemini default: gemini-1.5-flash
# OpenAI default: gpt-4o-mini
# Anthropic default: claude-3-haiku-20240307
LLM_MODEL=
LLM_TEMPERATURE=0.2

# ─────────────────────────────────────────────────────────────────────────────
# Provider API Keys (Fill the one corresponding to LLM_PROVIDER)
# Keep all API keys strictly on the backend. NEVER expose keys in extension files.
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Source Discovery & Web Search Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Options:
#   - "duckduckgo" (Default; works out-of-the-box with no API key)
#   - "tavily"     (High-accuracy research search; requires TAVILY_API_KEY)
#   - "mock"       (Offline deterministic search for testing)
SEARCH_PROVIDER=duckduckgo

# Tavily API Key (Optional; only used if SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Server Network Configuration
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
